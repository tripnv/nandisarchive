#!/bin/sh

# Prevent infinite recursion if we are amending inside the hook
if [ -n "$POST_COMMIT_RUNNING" ]; then
    exit 0
fi

echo "🚀 Post-commit: Building site..."

# Run the build (which also formats output)
uv run build.py

# Check if docs changed
if ! git diff --quiet docs/; then
    echo "📄 Changes detected in docs/. Amending commit..."
    
    # Stage the docs
    git add docs/
    
    # Amend the commit silently, preventing pre-commit checks (already ran)
    # and preventing post-commit recursion via variable
    export POST_COMMIT_RUNNING=1
    git commit --amend --no-edit --no-verify
    
    echo "✅ Commit updated with built files."
else
    echo "✨ No build changes."
fi
